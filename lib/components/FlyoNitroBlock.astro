---
import registry from "virtual:flyo-components";
import type { AstroComponentFactory } from "astro/dist/runtime/server";
import { componentKey } from "@flyo/nitro-astro/componentKey";
import { Block } from "@flyo/nitro-typescript";

interface Props {
  block: Block;
  [prop: string]: unknown;
}

const { block, ...props } = Astro.props;

/* @vite-ignore */
let Component: AstroComponentFactory | null = null;

const key: string = componentKey(block.component as string);
// hasOwn, not `key in`: the registry is a plain object, so a block named
// "constructor" or "toString" would otherwise resolve to Object.prototype.
const componentFound: boolean = Object.hasOwn(registry.components, key);

if (componentFound) {
  Component = registry.components[key];
} else {
  Component = registry.fallback;
}
---

{Component && <Component block={block} {...props} />}
