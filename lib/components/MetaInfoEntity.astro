---
import { Entity } from "@flyo/nitro-typescript";
import MetaInfo from "./MetaInfo.astro";

interface Props {
  response: Entity;
}

const { response } = Astro.props;
---

<MetaInfo
  title={response.entity?.entity_title}
  description={response.entity?.entity_teaser}
  image={response.entity?.entity_image}
  jsonld={response.jsonld}
/>
{
  /*
   * A draft link is a preview of content that is still offline: it must not end
   * up in an index, and it stops working when the link expires. Caching is the
   * route's call — `disableCache(Astro)` — not this component's.
   */
  response.is_draft && <meta name="robots" content="noindex, nofollow" />
}
