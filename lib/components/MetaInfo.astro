---
import { flyoImageUrl } from "@flyo/nitro-astro";
import type { MetaImage } from "@flyo/nitro-typescript";

interface Props {
  title?: string;
  description?: string;
  image?: MetaImage | null;
  jsonld?: object | null;
}

const { title, image, description, jsonld } = Astro.props;
const jsonLdString = jsonld ? JSON.stringify(jsonld) : null;

// `meta_json.image` is a URL string when a meta image is set and `false` when
// none is, so the source has to be checked by type, not by truthiness.
const imageSrc = typeof image === "string" && image ? image : null;

// Transform image to 1200x600 jpg for optimal social media display
const transformedImage = imageSrc
  ? flyoImageUrl(imageSrc, { width: 1200, height: 630, format: "jpg" })
  : null;
const transformedTwitterImage = imageSrc
  ? flyoImageUrl(imageSrc, { width: 1200, height: 600, format: "jpg" })
  : null;

const ogUrl = Astro.url.href; // absolute URL
---

{
  title && (
    <>
      <meta name="title" content={title} />
      <meta property="og:title" content={title} />
      <meta name="twitter:title" content={title} />
    </>
  )
}
{
  description && (
    <>
      <meta name="description" content={description} />
      <meta property="og:description" content={description} />
      <meta name="twitter:description" content={description} />
    </>
  )
}
{
  imageSrc && (
    <>
      <meta name="image" content={transformedImage} />
      <meta property="og:image" content={transformedImage} />
      <meta name="twitter:image" content={transformedTwitterImage} />
    </>
  )
}
{jsonLdString && <script type="application/ld+json" set:html={jsonLdString} />}
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta property="og:url" content={ogUrl} />
<link rel="canonical" href={ogUrl} />
